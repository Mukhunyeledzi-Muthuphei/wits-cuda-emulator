#!/bin/bash
# wcu — build and run CUDA C programs without an NVIDIA GPU.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CC="${CC:-clang}"
export WCU_VIEWER="${WCU_VIEWER:-$ROOT/viewer/viewer.html}"

usage() {
    cat <<EOF
usage:
  wcu run [--open] file.cu [-- program arguments]
        build and run; --open shows the visualization in your browser
  wcu build file.cu [more .cu/.c files] [-o program] [compiler flags]
  wcu translate file.cu
        print the plain C that wcu generates

environment:
  WCU_ORDER=sequential  run GPU threads in order (default: shuffled, like a real GPU)
  WCU_STRICT=1          stop at the first error
  WCU_DEVICE_MB=512     size of the simulated device memory (default 4096)
  WCU_TRACE=0           skip writing the visualization
EOF
}

ensure_built() {
    make -s -C "$ROOT" all >/dev/null || { echo "wcu: failed to build the emulator" >&2; exit 1; }
}

build() {
    local out="" s name c
    local -a srcs=() cflags=() ldflags=() objs=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -o) out="$2"; shift 2 ;;
            -o*) out="${1#-o}"; shift ;;
            -l*|-L*|-framework) ldflags+=("$1"); shift ;;
            *.cu|*.c) srcs+=("$1"); shift ;;
            *) cflags+=("$1"); shift ;;
        esac
    done
    if [ ${#srcs[@]} -eq 0 ]; then
        echo "wcu: no source files given" >&2
        exit 2
    fi
    if [ -z "$out" ]; then
        name="$(basename "${srcs[0]}")"
        out="${name%.*}"
    fi
    local work
    work="$(dirname "$out")/.wcu-obj"
    mkdir -p "$work"
    for s in "${srcs[@]}"; do
        name="$(basename "$s")"
        name="${name%.*}"
        c="$s"
        if [[ "$s" == *.cu ]]; then
            c="$work/$name.cu.c"
            "$ROOT/build/wcu-translate" "$s" -o "$c" || exit 1
        fi
        "$CC" -std=gnu17 -g -O0 -Wall -Wno-unused-variable -Wno-unused-function \
            -I"$ROOT/include" ${cflags[@]+"${cflags[@]}"} -c "$c" -o "$work/$name.o" || exit 1
        objs+=("$work/$name.o")
    done
    "$CC" -g "${objs[@]}" "$ROOT/build/libwcu.a" -lm ${ldflags[@]+"${ldflags[@]}"} -o "$out" || exit 1
}

run() {
    local open=0 name exe
    local -a files=() args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --open|--viz) open=1; shift ;;
            --) shift; args=("$@"); break ;;
            *) files+=("$1"); shift ;;
        esac
    done
    if [ ${#files[@]} -eq 0 ]; then
        usage
        exit 2
    fi
    name="$(basename "${files[0]}")"
    name="${name%.*}"
    mkdir -p .wcu
    exe=".wcu/$name"
    build "${files[@]}" -o "$exe"
    local status=0
    "$exe" ${args[@]+"${args[@]}"} || status=$?
    if [ "$open" = 1 ] && [ -f "$exe.wcu.html" ]; then
        if command -v open >/dev/null; then open "$exe.wcu.html"
        elif command -v xdg-open >/dev/null; then xdg-open "$exe.wcu.html"
        fi
    fi
    exit $status
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
    run) ensure_built; run "$@" ;;
    build) ensure_built; build "$@" ;;
    translate) ensure_built; exec "$ROOT/build/wcu-translate" "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "wcu: unknown command '$cmd'" >&2; usage; exit 2 ;;
esac
